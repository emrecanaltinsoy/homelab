# Telegram bot token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# GitHub Copilot / OpenAI-compatible credentials
# For GitHub Copilot, set the base URL to the Copilot API endpoint and use your token
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.githubcopilot.com

# Web dashboard credentials (basic auth)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Generate with: openssl rand -hex 32
DASHBOARD_SECRET=
